# ARK Google Workspace MCP — Railway env vars
# Copy this file to .env for local testing. On Railway, paste these into
# the project's Variables UI (NEVER commit a populated .env to git).

# ----------------------------------------------------------------------------
# Required: OAuth 2.1 multi-user mode + stateless transport
# ----------------------------------------------------------------------------
MCP_ENABLE_OAUTH21=true
WORKSPACE_MCP_STATELESS_MODE=true

# ----------------------------------------------------------------------------
# Required: Google OAuth client (from console.cloud.google.com → Clients)
# Use the "Web application" type client, NOT "Desktop". Project: Claude Workspace MCP.
# ----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Set after first Railway deploy (the public URL Railway assigns).
# Must match exactly the redirect URI registered in the GCP OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=https://REPLACE-ME.up.railway.app/oauth2callback
WORKSPACE_EXTERNAL_URL=https://REPLACE-ME.up.railway.app

# ----------------------------------------------------------------------------
# Tool surface
# ----------------------------------------------------------------------------
# 'extended' is required for draft_gmail_message (the daily-summary artifact's
# auto-draft tool). 'core' is too narrow; 'complete' is broader than needed.
WORKSPACE_MCP_TOOL_TIER=extended

# ----------------------------------------------------------------------------
# Token storage — Railway Volume mounted at /data
# Don't mount under /app/* — setuptools' editable install scans the project
# root for Python packages, finds the volume's lost+found dir, and crashes
# trying to write __init__.py into a root-owned location.
# ----------------------------------------------------------------------------
WORKSPACE_MCP_CREDENTIAL_STORE_BACKEND=local_directory
WORKSPACE_MCP_CREDENTIALS_DIR=/data

# ----------------------------------------------------------------------------
# Server bind
# DO NOT set PORT explicitly on Railway. Railway auto-injects PORT=<random>
# AND routes its public domain to that same port. If you override PORT,
# the app binds to your value but the edge keeps routing to Railway's
# value -> 502s. The server reads PORT first then WORKSPACE_MCP_PORT
# (oauth_config.py:29), so leave PORT unset and let Railway own it.
# WORKSPACE_MCP_PORT is kept for local dev and ignored when PORT is set.
# ----------------------------------------------------------------------------
WORKSPACE_MCP_HOST=0.0.0.0
WORKSPACE_MCP_PORT=8000

# ----------------------------------------------------------------------------
# Encryption key for OAuth-proxy stored tokens. Generate ONCE with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Setting this explicitly means a client-secret rotation won't invalidate
# stored tokens. Leave empty to fall back to deriving from CLIENT_SECRET.
# ----------------------------------------------------------------------------
FASTMCP_SERVER_AUTH_GOOGLE_JWT_SIGNING_KEY=

# ----------------------------------------------------------------------------
# Should always be 0/unset on Railway (HTTPS-terminated). Only set to 1 for
# local dev with http://localhost callbacks.
# ----------------------------------------------------------------------------
OAUTHLIB_INSECURE_TRANSPORT=0
OAUTH2_ALLOW_INSECURE_TRANSPORT=false
